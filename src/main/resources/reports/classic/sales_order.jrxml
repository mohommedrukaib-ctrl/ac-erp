<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SalesOrder" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
    <parameter name="ORDER_ID" class="java.lang.Integer"/>
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    
    <queryString>
        <![CDATA[
            SELECT s.order_number, s.order_date, s.total_amount,
                   c.name AS customer_name,
                   sl.description, sl.quantity, sl.unit_price, sl.total_price
            FROM sales_orders s
            JOIN customers c ON s.customer_id = c.id
            JOIN sales_order_lines sl ON s.id = sl.order_id
            WHERE s.id = $P{ORDER_ID}
        ]]>
    </queryString>
    <field name="order_number" class="java.lang.String"/>
    <field name="order_date" class="java.sql.Date"/>
    <field name="total_amount" class="java.math.BigDecimal"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unit_price" class="java.math.BigDecimal"/>
    <field name="total_price" class="java.math.BigDecimal"/>
    
    <title>
        <band height="90">
            <textField><reportElement x="0" y="0" width="300" height="25"/><textElement><font size="16" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
            <staticText><reportElement x="350" y="0" width="185" height="30"/><textElement textAlignment="Right"><font size="20" isBold="true"/></textElement><text><![CDATA[SALES ORDER]]></text></staticText>
            <textField><reportElement x="0" y="40" width="250" height="20"/><textFieldExpression><![CDATA["Order #: " + $F{order_number}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="40" width="185" height="20"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Date: " + $F{order_date}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="60" width="250" height="20"/><textFieldExpression><![CDATA["Customer: " + $F{customer_name}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="85" width="535" height="1"/></line>
        </band>
    </title>
    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="250" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
            <staticText><reportElement x="260" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Qty]]></text></staticText>
            <staticText><reportElement x="350" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Price]]></text></staticText>
            <staticText><reportElement x="450" y="0" width="85" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
            <line><reportElement x="0" y="20" width="535" height="1"/></line>
        </band>
    </columnHeader>
    <detail>
        <band height="25">
            <textField><reportElement x="0" y="2" width="250" height="20"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
            <textField><reportElement x="260" y="2" width="80" height="20"/><textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="2" width="80" height="20"/><textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="2" width="85" height="20"/><textFieldExpression><![CDATA[$F{total_price}]]></textFieldExpression></textField>
        </band>
    </detail>
    <summary>
        <band height="50">
            <line><reportElement x="300" y="10" width="235" height="1"/></line>
            <textField><reportElement x="350" y="20" width="185" height="25"/><textElement><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["Total: " + $F{total_amount}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>