<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ServiceJobA5" pageWidth="420" pageHeight="595" columnWidth="380" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="JOB_ID" class="java.lang.Integer"/>
       <!-- Company Branding Parameters -->
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_TAGLINE" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS" class="java.lang.String"/>
    <parameter name="COMPANY_PHONE" class="java.lang.String"/>
    <parameter name="COMPANY_EMAIL" class="java.lang.String"/>
    <parameter name="COMPANY_WEBSITE" class="java.lang.String"/>
    <parameter name="COMPANY_TAX_NO" class="java.lang.String"/>
    <parameter name="COMPANY_FOOTER" class="java.lang.String"/>
    <parameter name="COMPANY_LOGO" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT j.job_number, j.scheduled_date, j.ac_model_info, j.reported_issue, j.resolution_notes,
                   c.name AS customer_name, c.phone, c.address
            FROM service_jobs j
            JOIN customers c ON j.customer_id = c.id
            WHERE j.id = $P{JOB_ID}
        ]]>
    </queryString>

    <field name="job_number" class="java.lang.String"/>
    <field name="scheduled_date" class="java.sql.Date"/>
    <field name="ac_model_info" class="java.lang.String"/>
    <field name="reported_issue" class="java.lang.String"/>
    <field name="resolution_notes" class="java.lang.String"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="phone" class="java.lang.String"/>
    <field name="address" class="java.lang.String"/>

    <title>
    <band height="70">
        <!-- Company Logo from Settings -->
        <image onErrorType="Blank">
            <reportElement x="0" y="0" width="150" height="60"/>
            <imageExpression><![CDATA[$P{COMPANY_LOGO}]]></imageExpression>
        </image>

        <!-- Company Name & Tagline from Settings -->
        <textField>
            <reportElement x="160" y="0" width="220" height="20"/>
            <textElement><font size="14" isBold="true"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
        </textField>
        
        <textField>
            <reportElement x="160" y="22" width="220" height="15"/>
            <textElement><font size="9" isItalic="true"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_TAGLINE}]]></textFieldExpression>
        </textField>
        
        <textField>
            <reportElement x="160" y="38" width="220" height="25"/>
            <textElement><font size="8"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_ADDRESS} + "\nPh: " + $P{COMPANY_PHONE}]]></textFieldExpression>
        </textField>
    </band>
</title>
    <detail>
        <band height="200">
            <staticText><reportElement x="0" y="0" width="100" height="15"/><textElement><font isBold="true"/></textElement><text><![CDATA[AC Unit Details:]]></text></staticText>
            <textField><reportElement x="0" y="15" width="380" height="30"/><textFieldExpression><![CDATA[$F{ac_model_info} != null ? $F{ac_model_info} : "N/A"]]></textFieldExpression></textField>

            <staticText><reportElement x="0" y="50" width="100" height="15"/><textElement><font isBold="true"/></textElement><text><![CDATA[Issue / Complaint:]]></text></staticText>
            <textField><reportElement x="0" y="65" width="380" height="40"/><textFieldExpression><![CDATA[$F{reported_issue}]]></textFieldExpression></textField>

            <staticText><reportElement x="0" y="110" width="150" height="15"/><textElement><font isBold="true"/></textElement><text><![CDATA[Technician Notes / Parts Used:]]></text></staticText>
            <rectangle><reportElement x="0" y="125" width="380" height="65" forecolor="#CCCCCC"/></rectangle>
        </band>
    </detail>

    <summary>
        <band height="60">
            <staticText>
                <reportElement x="0" y="10" width="200" height="20"/>
                <text><![CDATA[Tech Signature: __________________]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="10" width="180" height="20"/>
                <text><![CDATA[Client Sign: __________________]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>