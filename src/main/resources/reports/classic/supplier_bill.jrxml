<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="SupplierBill" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
    <parameter name="BILL_ID" class="java.lang.Integer"/>
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    
    <queryString>
        <![CDATA[
            SELECT b.bill_number, b.bill_date, b.due_date, b.supplier_invoice_ref, b.status, 
                   b.subtotal, b.tax_amount, b.total_amount,
                   s.name AS supplier_name,
                   bl.description, bl.quantity, bl.unit_price, bl.line_total
            FROM supplier_bills b
            LEFT JOIN suppliers s ON b.supplier_id = s.id
            LEFT JOIN supplier_bill_lines bl ON b.id = bl.bill_id
            WHERE b.id = $P{BILL_ID}
        ]]>
    </queryString>
    <field name="bill_number" class="java.lang.String"/>
    <field name="bill_date" class="java.sql.Date"/>
    <field name="due_date" class="java.sql.Date"/>
    <field name="supplier_invoice_ref" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="tax_amount" class="java.math.BigDecimal"/>
    <field name="total_amount" class="java.math.BigDecimal"/>
    <field name="supplier_name" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unit_price" class="java.math.BigDecimal"/>
    <field name="line_total" class="java.math.BigDecimal"/>
    
    <title>
        <band height="100">
            <textField><reportElement x="0" y="0" width="300" height="25"/><textElement><font size="16" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
            <staticText><reportElement x="350" y="0" width="185" height="30"/><textElement textAlignment="Right"><font size="18" isBold="true"/></textElement><text><![CDATA[SUPPLIER BILL]]></text></staticText>
            
            <textField><reportElement x="0" y="40" width="250" height="15"/><textFieldExpression><![CDATA["Bill #: " + $F{bill_number}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="55" width="250" height="15"/><textFieldExpression><![CDATA["Supplier: " + ($F{supplier_name} != null ? $F{supplier_name} : "")]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="70" width="250" height="15"/><textFieldExpression><![CDATA["Supplier Ref: " + ($F{supplier_invoice_ref} != null ? $F{supplier_invoice_ref} : "")]]></textFieldExpression></textField>

            <textField><reportElement x="350" y="40" width="185" height="15"/><textElement textAlignment="Right"/></textFieldExpression><![CDATA["Date: " + $F{bill_date}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="55" width="185" height="15"/><textElement textAlignment="Right"/></textFieldExpression><![CDATA["Due Date: " + $F{due_date}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="70" width="185" height="15"/><textElement textAlignment="Right"/></textFieldExpression><![CDATA["Status: " + $F{status}]]></textFieldExpression></textField>
            
            <line><reportElement x="0" y="95" width="535" height="1"/></line>
        </band>
    </title>
    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="250" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
            <staticText><reportElement x="260" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Qty]]></text></staticText>
            <staticText><reportElement x="350" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Unit Price]]></text></staticText>
            <staticText><reportElement x="450" y="0" width="85" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
            <line><reportElement x="0" y="20" width="535" height="1"/></line>
        </band>
    </columnHeader>
    <detail>
        <band height="25">
            <textField><reportElement x="0" y="2" width="250" height="20"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
            <textField><reportElement x="260" y="2" width="80" height="20"/><textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="2" width="80" height="20"/><textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="2" width="85" height="20"/><textFieldExpression><![CDATA[$F{line_total}]]></textFieldExpression></textField>
        </band>
    </detail>
    <summary>
        <band height="80">
            <line><reportElement x="300" y="10" width="235" height="1"/></line>
            <textField><reportElement x="350" y="15" width="185" height="20"/><textElement textAlignment="Right"><font size="11"/></textElement><textFieldExpression><![CDATA["Subtotal: " + $F{subtotal}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="35" width="185" height="20"/><textElement textAlignment="Right"><font size="11"/></textElement><textFieldExpression><![CDATA["Tax: " + $F{tax_amount}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="55" width="185" height="20"/><textElement textAlignment="Right"><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["Total: " + $F{total_amount}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>