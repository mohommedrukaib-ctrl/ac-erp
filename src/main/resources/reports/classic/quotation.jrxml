<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Quotation" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
    <parameter name="QUOTE_ID" class="java.lang.Integer"/>
      <!-- Company Branding Parameters -->
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_TAGLINE" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS" class="java.lang.String"/>
    <parameter name="COMPANY_PHONE" class="java.lang.String"/>
    <parameter name="COMPANY_EMAIL" class="java.lang.String"/>
    <parameter name="COMPANY_WEBSITE" class="java.lang.String"/>
    <parameter name="COMPANY_TAX_NO" class="java.lang.String"/>
    <parameter name="COMPANY_FOOTER" class="java.lang.String"/>
    <parameter name="COMPANY_LOGO" class="java.lang.String"/>
    
    <queryString>
        <![CDATA[
            SELECT q.quote_number, q.quote_date, q.subtotal, q.tax_amount, q.total_amount,
                   q.document_discount_type, q.document_discount_value, q.document_discount_amount,
                   c.name AS customer_name, c.phone,
                   ql.description, ql.quantity, ql.unit_price, ql.total_price,
                   ql.discount_type, ql.discount_value, ql.package_price
            FROM quotations q
            JOIN customers c ON q.customer_id = c.id
            JOIN quotation_lines ql ON q.id = ql.quotation_id
            WHERE q.id = $P{QUOTE_ID}
        ]]>
    </queryString>
    <field name="quote_number" class="java.lang.String"/>
    <field name="quote_date" class="java.sql.Date"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="tax_amount" class="java.math.BigDecimal"/>
    <field name="total_amount" class="java.math.BigDecimal"/>
    <field name="document_discount_type" class="java.lang.String"/>
    <field name="document_discount_value" class="java.math.BigDecimal"/>
    <field name="document_discount_amount" class="java.math.BigDecimal"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unit_price" class="java.math.BigDecimal"/>
    <field name="total_price" class="java.math.BigDecimal"/>
    <field name="discount_type" class="java.lang.String"/>
    <field name="discount_value" class="java.math.BigDecimal"/>
    <field name="package_price" class="java.lang.Boolean"/>
    
    <title>
    <band height="70">
        <!-- Company Logo from Settings -->
        <image onErrorType="Blank">
            <reportElement x="0" y="0" width="150" height="60"/>
            <imageExpression><![CDATA[$P{COMPANY_LOGO}]]></imageExpression>
        </image>

        <!-- Company Name & Tagline from Settings -->
        <textField textAdjust="StretchHeight">
            <reportElement x="160" y="0" width="220" height="20"/>
            <textElement><font size="14" isBold="true"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
        </textField>
        
        <textField>
            <reportElement x="160" y="22" width="220" height="15"/>
            <textElement><font size="9" isItalic="true"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_TAGLINE}]]></textFieldExpression>
        </textField>
        
        <textField textAdjust="StretchHeight">
            <reportElement x="160" y="38" width="220" height="25"/>
            <textElement><font size="8"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_ADDRESS} + "\nPh: " + $P{COMPANY_PHONE}]]></textFieldExpression>
        </textField>
    </band>
</title>
    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="215" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
            <staticText><reportElement x="220" y="0" width="50" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Qty]]></text></staticText>
            <staticText><reportElement x="275" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Price]]></text></staticText>
            <staticText><reportElement x="360" y="0" width="75" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Discount]]></text></staticText>
            <staticText><reportElement x="450" y="0" width="85" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
            <line><reportElement x="0" y="20" width="535" height="1"/></line>
        </band>
    </columnHeader>
    <detail>
        <band height="25" splitType="Stretch">
            <textField textAdjust="StretchHeight"><reportElement x="0" y="2" width="215" height="20"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
            <textField><reportElement x="220" y="2" width="50" height="20"/><textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField>
            <textField><reportElement x="275" y="2" width="80" height="20"/><textFieldExpression><![CDATA[($F{package_price} ? "Pkg " : "") + $F{unit_price}]]></textFieldExpression></textField>
            <textField><reportElement x="360" y="2" width="75" height="20"/><textFieldExpression><![CDATA[$F{discount_value} == null ? "" : ("AMOUNT".equals($F{discount_type}) ? $F{discount_value}.toPlainString() : $F{discount_value}.stripTrailingZeros().toPlainString() + "%")]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="2" width="85" height="20"/><textFieldExpression><![CDATA[$F{total_price}]]></textFieldExpression></textField>
        </band>
    </detail>
    <summary>
        <band height="100">
            <line><reportElement x="300" y="10" width="235" height="1"/></line>
            <textField><reportElement x="350" y="15" width="185" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Subtotal: " + $F{subtotal}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="35" width="185" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Tax: " + $F{tax_amount}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="55" width="185" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Discount (" + ($F{document_discount_type}.equals("PERCENT") ? $F{document_discount_value} + "%" : $F{document_discount_value}) + "): " + $F{document_discount_amount}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="75" width="185" height="25"/><textElement><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["Total: " + $F{total_amount}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>