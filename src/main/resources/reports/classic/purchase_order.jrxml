<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PurchaseOrder" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
    <parameter name="PO_ID" class="java.lang.Integer"/>
       <!-- Company Branding Parameters -->
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_TAGLINE" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS" class="java.lang.String"/>
    <parameter name="COMPANY_PHONE" class="java.lang.String"/>
    <parameter name="COMPANY_EMAIL" class="java.lang.String"/>
    <parameter name="COMPANY_WEBSITE" class="java.lang.String"/>
    <parameter name="COMPANY_TAX_NO" class="java.lang.String"/>
    <parameter name="COMPANY_FOOTER" class="java.lang.String"/>
    <parameter name="COMPANY_LOGO" class="java.lang.String"/>
    <queryString>
        <![CDATA[
            SELECT p.po_number, p.po_date, p.total_amount,
                   s.name AS supplier_name,
                   pl.description, pl.quantity, pl.unit_cost, pl.line_total
            FROM purchase_orders p
            JOIN suppliers s ON p.supplier_id = s.id
            JOIN purchase_order_lines pl ON p.id = pl.po_id
            WHERE p.id = $P{PO_ID}
        ]]>
    </queryString>
    <field name="po_number" class="java.lang.String"/>
    <field name="po_date" class="java.sql.Date"/>
    <field name="total_amount" class="java.math.BigDecimal"/>
    <field name="supplier_name" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unit_cost" class="java.math.BigDecimal"/>
    <field name="line_total" class="java.math.BigDecimal"/>
    
   <title>
    <band height="70">
        <!-- Company Logo from Settings -->
        <image onErrorType="Blank">
            <reportElement x="0" y="0" width="150" height="60"/>
            <imageExpression><![CDATA[$P{COMPANY_LOGO}]]></imageExpression>
        </image>

        <!-- Company Name & Tagline from Settings -->
        <textField>
            <reportElement x="160" y="0" width="220" height="20"/>
            <textElement><font size="14" isBold="true"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
        </textField>
        
        <textField>
            <reportElement x="160" y="22" width="220" height="15"/>
            <textElement><font size="9" isItalic="true"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_TAGLINE}]]></textFieldExpression>
        </textField>
        
        <textField>
            <reportElement x="160" y="38" width="220" height="25"/>
            <textElement><font size="8"/></textElement>
            <textFieldExpression><![CDATA[$P{COMPANY_ADDRESS} + "\nPh: " + $P{COMPANY_PHONE}]]></textFieldExpression>
        </textField>
    </band>
</title>
    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="250" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
            <staticText><reportElement x="260" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Qty]]></text></staticText>
            <staticText><reportElement x="350" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Unit Cost]]></text></staticText>
            <staticText><reportElement x="450" y="0" width="85" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
            <line><reportElement x="0" y="20" width="535" height="1"/></line>
        </band>
    </columnHeader>
    <detail>
        <band height="25">
            <textField><reportElement x="0" y="2" width="250" height="20"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
            <textField><reportElement x="260" y="2" width="80" height="20"/><textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="2" width="80" height="20"/><textFieldExpression><![CDATA[$F{unit_cost}]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="2" width="85" height="20"/><textFieldExpression><![CDATA[$F{line_total}]]></textFieldExpression></textField>
        </band>
    </detail>
    <summary>
        <band height="50">
            <line><reportElement x="300" y="10" width="235" height="1"/></line>
            <textField><reportElement x="350" y="20" width="185" height="25"/><textElement><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["Total: " + $F{total_amount}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>