<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="WarrantyCertificate" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="40" bottomMargin="40" uuid="e3b0c442-989b-12d3-a456-426614174000">
    <parameter name="SERIAL_ID" class="java.lang.Integer"/>
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <queryString>
        <![CDATA[
            SELECT ps.serial_number, p.name as product_name, p.code as product_code, 
                   ps.warranty_expiry_date, c.name as customer_name
            FROM product_serials ps
            JOIN products p ON ps.product_id = p.id
            JOIN customers c ON ps.customer_id = c.id
            WHERE ps.id = $P{SERIAL_ID}
        ]]>
    </queryString>
    <field name="serial_number" class="java.lang.String"/>
    <field name="product_name" class="java.lang.String"/>
    <field name="warranty_expiry_date" class="java.sql.Date"/>
    <field name="customer_name" class="java.lang.String"/>
    <title>
        <band height="150">
            <textField>
                <reportElement x="0" y="0" width="535" height="40" uuid="b1a9f1"/>
                <textElement textAlignment="Center">
                    <font size="24" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="50" width="535" height="30" uuid="b1a9f2"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true" isUnderline="true"/>
                </textElement>
                <text><![CDATA[OFFICIAL WARRANTY CERTIFICATE]]></text>
            </staticText>
        </band>
    </title>
    <detail>
        <band height="200">
            <staticText><reportElement x="50" y="20" width="150" height="20" uuid="c1"/><text><![CDATA[Customer Name:]]></text></staticText>
            <textField><reportElement x="200" y="20" width="300" height="20" uuid="c2"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression></textField>
            
            <staticText><reportElement x="50" y="60" width="150" height="20" uuid="c3"/><text><![CDATA[Product Model:]]></text></staticText>
            <textField><reportElement x="200" y="60" width="300" height="20" uuid="c4"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression></textField>

            <staticText><reportElement x="50" y="100" width="150" height="20" uuid="c5"/><text><![CDATA[Serial Number:]]></text></staticText>
            <textField><reportElement x="200" y="100" width="300" height="20" uuid="c6"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{serial_number}]]></textFieldExpression></textField>

            <staticText><reportElement x="50" y="140" width="150" height="20" uuid="c7"/><text><![CDATA[Warranty Valid Until:]]></text></staticText>
            <textField pattern="MMMMM dd, yyyy"><reportElement x="200" y="140" width="300" height="20" uuid="c8"/><textElement><font isBold="true" size="14"/></textElement><textFieldExpression><![CDATA[$F{warranty_expiry_date}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="535" height="30" uuid="f1"/>
                <textElement textAlignment="Center"><font size="10" isItalic="true"/></textElement>
                <text><![CDATA[This certificate is digitally generated by ACE ERP and requires no signature.]]></text>
            </staticText>
        </band>
    </pageFooter>
</jasperReport>