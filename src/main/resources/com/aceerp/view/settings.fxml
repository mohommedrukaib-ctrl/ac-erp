<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aceerp.controller.SettingsController"
      spacing="15">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="⚙" style="-fx-font-size: 24px;"/>
        <Label text="Settings" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⟳ Reload" onAction="#onReload" styleClass="btn-secondary"/>
        <Button text="💾 Save Changes" onAction="#onSave" styleClass="btn-primary"/>
    </HBox>

    <Label fx:id="statusLabel" wrapText="true"/>

    <!-- Settings Tabs -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- ===== COMPANY TAB ===== -->
        <Tab text="Company">
            <ScrollPane fitToWidth="true">
                <VBox spacing="12">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="Business Information" styleClass="section-title"/>

                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Business Name *" styleClass="field-label"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="companyNameField"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Legal Name" styleClass="field-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="companyLegalNameField"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Address" styleClass="field-label"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextArea fx:id="companyAddressField" prefRowCount="3"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Phone" styleClass="field-label"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="companyPhoneField"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Email" styleClass="field-label"
                               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="companyEmailField"
                                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Website" styleClass="field-label"
                               GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="companyWebsiteField"
                                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Tax/VAT Number" styleClass="field-label"
                               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="companyTaxNumberField"
                                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Registration No." styleClass="field-label"
                               GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextField fx:id="companyRegistrationField"
                                   GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ===== CURRENCY TAB ===== -->
        <Tab text="Currency &amp; Formatting">
            <ScrollPane fitToWidth="true">
                <VBox spacing="12">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="Currency Settings" styleClass="section-title"/>

                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Currency Code *" styleClass="field-label"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="currencyCodeField" promptText="USD, AED, EUR..."
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Currency Symbol *" styleClass="field-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
<TextField fx:id="currencySymbolField" promptText="e.g. AED, EUR symbol"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Decimal Places *" styleClass="field-label"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="currencyDecimalsField" promptText="0-4"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Symbol Position *" styleClass="field-label"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ChoiceBox fx:id="currencyPositionChoice" maxWidth="Infinity"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ===== INVOICE TAB ===== -->
        <Tab text="Invoice &amp; Numbering">
            <ScrollPane fitToWidth="true">
                <VBox spacing="12">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="Invoice Settings" styleClass="section-title"/>

                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Invoice Prefix" styleClass="field-label"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="invoicePrefixField" promptText="INV-"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Next Invoice No." styleClass="field-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="invoiceNextNumberField"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Default Due Days" styleClass="field-label"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="invoiceDueDaysField"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Default Terms" styleClass="field-label"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextArea fx:id="invoiceTermsField" prefRowCount="3"
                                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Label text="Quotation Settings" styleClass="section-title"/>
                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Quotation Prefix" styleClass="field-label"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="quotationPrefixField" promptText="QTN-"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Next Quotation No." styleClass="field-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="quotationNextNumberField"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Label text="Purchase Order Settings" styleClass="section-title"/>
                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="PO Prefix" styleClass="field-label"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="purchasePrefixField" promptText="PO-"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Next PO No." styleClass="field-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="purchaseNextNumberField"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ===== TAX TAB ===== -->
        <Tab text="Tax">
            <ScrollPane fitToWidth="true">
                <VBox spacing="12">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="Tax / VAT Settings" styleClass="section-title"/>

                    <CheckBox fx:id="taxEnabledCheck" text="Enable tax on invoices"/>

                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Tax Name" styleClass="field-label"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="taxNameField" promptText="VAT, GST, Sales Tax..."
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Default Rate (%)" styleClass="field-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="taxDefaultRateField" promptText="e.g., 5.00"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ===== SYSTEM TAB ===== -->
        <Tab text="System">
            <ScrollPane fitToWidth="true">
                <VBox spacing="12">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="System Preferences" styleClass="section-title"/>

                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="180"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Date Format" styleClass="field-label"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="dateFormatField" promptText="yyyy-MM-dd, dd/MM/yyyy..."
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Items Per Page" styleClass="field-label"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="itemsPerPageField"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>
</VBox>