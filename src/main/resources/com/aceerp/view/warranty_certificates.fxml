<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aceerp.controller.WarrantyCertificateController"
      spacing="12">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Warranty Certificates" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary"/>
        <Button text="Print Selected Certificate" onAction="#handlePrintCertificate" styleClass="btn-primary"/>
    </HBox>

    <Label text="Register a product serial number to create a printable warranty certificate."
           styleClass="dashboard-label"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="productSelector" promptText="Select product" prefWidth="220"/>
        <ComboBox fx:id="customerSelector" promptText="Select customer" prefWidth="220"/>
        <TextField fx:id="serialNumberField" promptText="Serial number" prefWidth="150"/>
        <DatePicker fx:id="installationDatePicker" promptText="Installation date"/>
        <DatePicker fx:id="expiryDatePicker" promptText="Warranty expires"/>
        <Button text="Register Warranty" onAction="#handleRegister" styleClass="btn-primary"/>
    </HBox>

    <TableView fx:id="registrationsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="serialColumn" text="Serial Number" prefWidth="150"/>
            <TableColumn fx:id="productColumn" text="Product" prefWidth="220"/>
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="200"/>
            <TableColumn fx:id="installedColumn" text="Installation Date" prefWidth="150"/>
            <TableColumn fx:id="expiryColumn" text="Warranty Expiry" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
