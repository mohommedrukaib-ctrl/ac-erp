<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.aceerp.controller.DashboardController"
      spacing="25"
      styleClass="dashboard-container">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Page Title -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="🏠" style="-fx-font-size: 24px;"/>
        <Label text="Dashboard" styleClass="page-title"/>
    </HBox>

    <!-- Subtitle with database status -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Database:" styleClass="dashboard-label"/>
        <Label fx:id="dbStatusLabel" text="Checking..." styleClass="dashboard-label"/>
    </HBox>

    <!-- Summary Cards Row -->
    <HBox spacing="20" alignment="CENTER_LEFT">

        <!-- Customers Card -->
        <VBox styleClass="dashboard-card" spacing="5" alignment="CENTER"
              prefWidth="200" prefHeight="120">
            <Label text="👤" style="-fx-font-size: 28px;"/>
            <Label fx:id="customerCountLabel" text="0" styleClass="dashboard-card-value"/>
            <Label text="Customers" styleClass="dashboard-card-label"/>
        </VBox>

        <!-- Products Card -->
        <VBox styleClass="dashboard-card" spacing="5" alignment="CENTER"
              prefWidth="200" prefHeight="120">
            <Label text="📦" style="-fx-font-size: 28px;"/>
            <Label fx:id="productCountLabel" text="0" styleClass="dashboard-card-value"/>
            <Label text="Products" styleClass="dashboard-card-label"/>
        </VBox>

        <!-- Invoices Card -->
        <VBox styleClass="dashboard-card" spacing="5" alignment="CENTER"
              prefWidth="200" prefHeight="120">
            <Label text="📄" style="-fx-font-size: 28px;"/>
            <Label fx:id="invoiceCountLabel" text="0" styleClass="dashboard-card-value"/>
            <Label text="Invoices" styleClass="dashboard-card-label"/>
        </VBox>

        <!-- Revenue Card -->
        <VBox styleClass="dashboard-card" spacing="5" alignment="CENTER"
              prefWidth="200" prefHeight="120">
            <Label text="💰" style="-fx-font-size: 28px;"/>
            <Label fx:id="revenueLabel" text="0.00" styleClass="dashboard-card-value"/>
            <Label text="Monthly Revenue" styleClass="dashboard-card-label"/>
        </VBox>

    </HBox>

    <!-- Quick Actions Section -->
    <VBox spacing="10">
        <Label text="Quick Actions" styleClass="section-title"/>
        <HBox spacing="12">
            <Label text="📄 New Invoice" onMouseClicked="#handleQuickNewInvoice" styleClass="quick-action-btn" style="-fx-cursor: hand;"/>
            <Label text="👤 New Customer" onMouseClicked="#handleQuickNewCustomer" styleClass="quick-action-btn" style="-fx-cursor: hand;"/>
            <Label text="📦 New Product" onMouseClicked="#handleQuickNewProduct" styleClass="quick-action-btn" style="-fx-cursor: hand;"/>
            <Label text="🔧 New Service Job" onMouseClicked="#handleQuickNewServiceJob" styleClass="quick-action-btn" style="-fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Spacer to push content up -->
    <Region VBox.vgrow="ALWAYS"/>

</VBox>