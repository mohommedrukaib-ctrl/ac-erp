<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aceerp.controller.AccountingController"
      spacing="12" styleClass="content-pane">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Financial Accounting &amp; General Ledger"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="＋ New Journal Entry" onAction="#handleNewJournalEntry" styleClass="btn-primary"/>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary"/>
    </HBox>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ===================== Chart of Accounts ===================== -->
        <Tab text="Chart of Accounts">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <TableView fx:id="tblAccounts" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAccountCode" text="Code" prefWidth="100"/>
                        <TableColumn fx:id="colAccountName" text="Account Name" prefWidth="260"/>
                        <TableColumn fx:id="colAccountType" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="colAccountBalance" text="Balance" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- ===================== Journal Entries ===================== -->
        <Tab text="Journal Entries">
            <SplitPane dividerPositions="0.42" VBox.vgrow="ALWAYS">
                <VBox spacing="8">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Journal Vouchers" style="-fx-font-weight: bold;"/>
                    <TableView fx:id="tblJournalEntries" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colEntryNumber" text="Voucher #" prefWidth="110"/>
                            <TableColumn fx:id="colEntryDate" text="Date" prefWidth="95"/>
                            <TableColumn fx:id="colEntryRef" text="Reference" prefWidth="130"/>
                            <TableColumn fx:id="colEntryDesc" text="Memo" prefWidth="180"/>
                            <TableColumn fx:id="colEntryTotal" text="Amount" prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>
                <VBox spacing="8">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Voucher Lines (Debit / Credit)" style="-fx-font-weight: bold;"/>
                    <TableView fx:id="tblJournalLines" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colLineAccountCode" text="Code" prefWidth="80"/>
                            <TableColumn fx:id="colLineAccountName" text="Account" prefWidth="180"/>
                            <TableColumn fx:id="colLineDebit" text="Debit" prefWidth="110"/>
                            <TableColumn fx:id="colLineCredit" text="Credit" prefWidth="110"/>
                            <TableColumn fx:id="colLineDesc" text="Description" prefWidth="200"/>
                        </columns>
                    </TableView>
                    <HBox spacing="20" alignment="CENTER_RIGHT">
                        <Label text="Total Debit:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalDebit" text="0.00"/>
                        <Label text="Total Credit:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalCredit" text="0.00"/>
                    </HBox>
                </VBox>
            </SplitPane>
        </Tab>

        <!-- ===================== Trial Balance ===================== -->
        <Tab text="Trial Balance">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Trial Balance (Posted balances)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Total DR:" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblTbDebit" text="0.00" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                    <Label text="Total CR:" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblTbCredit" text="0.00" style="-fx-text-fill: #2980b9; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTbStatus" text="" style="-fx-font-weight: bold;"/>
                </HBox>
                <TableView fx:id="tblTrialBalance" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTbCode" text="Code" prefWidth="100"/>
                        <TableColumn fx:id="colTbName" text="Account" prefWidth="280"/>
                        <TableColumn fx:id="colTbType" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="colTbDebit" text="Debit" prefWidth="140"/>
                        <TableColumn fx:id="colTbCredit" text="Credit" prefWidth="140"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- ===================== Bank Reconciliation ===================== -->
        <Tab text="Bank Reconciliation">
            <VBox spacing="12">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <!-- Top Parameters -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 4;">
                    <Label text="Account:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbReconAccount" prefWidth="240"/>
                    <Label text="Statement Date:" style="-fx-font-weight: bold;"/>
                    <DatePicker fx:id="dpReconStatementDate" prefWidth="130"/>
                    <Label text="Statement Ending Balance:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtReconEndingBalance" promptText="0.00" prefWidth="120"/>
                    <Button text="📁 Import Statement (CSV)" onAction="#handleImportCsvStatement" styleClass="btn-secondary"/>
                </HBox>

                <!-- Summary Cards -->
                <HBox spacing="15" alignment="CENTER">
                    <VBox alignment="CENTER" prefWidth="160" style="-fx-background-color: #ffffff; -fx-padding: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                        <Label text="Beginning Balance" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="lblReconBeginningBalance" text="0.00" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="180" style="-fx-background-color: #ffffff; -fx-padding: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                        <Label text="Cleared Deposits (+)" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="lblReconClearedDeposits" text="0.00 (0)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="180" style="-fx-background-color: #ffffff; -fx-padding: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                        <Label text="Cleared Checks (-)" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="lblReconClearedChecks" text="0.00 (0)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="160" style="-fx-background-color: #ffffff; -fx-padding: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                        <Label text="Cleared Balance" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="lblReconClearedBalance" text="0.00" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="160" style="-fx-background-color: #ffffff; -fx-padding: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                        <Label text="Target Ending Balance" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="lblReconTargetBalance" text="0.00" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="160" style="-fx-background-color: #ffffff; -fx-padding: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                        <Label text="Difference (Target $0.00)" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="lblReconDifference" text="0.00" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                </HBox>

                <!-- Tables Split -->
                <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
                    <!-- Deposits Table -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Deposits &amp; Other Credits" style="-fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Select All" onAction="#handleSelectAllDeposits" style="-fx-font-size: 11px;"/>
                            <Button text="Unselect All" onAction="#handleUnselectAllDeposits" style="-fx-font-size: 11px;"/>
                        </HBox>
                        <TableView fx:id="tblDeposits" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colDepCleared" text="✓" prefWidth="40"/>
                                <TableColumn fx:id="colDepDate" text="Date" prefWidth="90"/>
                                <TableColumn fx:id="colDepRef" text="Ref #" prefWidth="100"/>
                                <TableColumn fx:id="colDepMemo" text="Memo" prefWidth="160"/>
                                <TableColumn fx:id="colDepAmount" text="Amount" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Checks Table -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Checks &amp; Payments" style="-fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Select All" onAction="#handleSelectAllChecks" style="-fx-font-size: 11px;"/>
                            <Button text="Unselect All" onAction="#handleUnselectAllChecks" style="-fx-font-size: 11px;"/>
                        </HBox>
                        <TableView fx:id="tblChecks" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colChkCleared" text="✓" prefWidth="40"/>
                                <TableColumn fx:id="colChkDate" text="Date" prefWidth="90"/>
                                <TableColumn fx:id="colChkRef" text="Ref #" prefWidth="100"/>
                                <TableColumn fx:id="colChkMemo" text="Memo" prefWidth="160"/>
                                <TableColumn fx:id="colChkAmount" text="Amount" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>
                </SplitPane>

                <!-- Action Footer -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="btnReconcileNow" text="Reconcile Now" onAction="#handleReconcileNow" styleClass="btn-primary" disable="true" style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>