<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aceerp.controller.SalesOrderController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Sales Orders" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="New Sales Order" onAction="#handleNewSalesOrder" styleClass="button-primary"/>
    </HBox>

    <HBox spacing="15" VBox.vgrow="ALWAYS">
        <VBox spacing="10" prefWidth="300">
            <TextField fx:id="searchField" promptText="Search Sales Orders..."/>
            <ListView fx:id="salesOrderListView" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox fx:id="detailsPane" spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #ddd;">
            <GridPane hgap="15" vgap="15">
                <Label text="Customer:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <TextField fx:id="customerSearchField" promptText="Search or type customer name..." HBox.hgrow="ALWAYS"/>
                    <Button text="+" onAction="#handleQuickAddCustomer" style="-fx-font-weight: bold; -fx-background-color: #28a745; -fx-text-fill: white;">
                        <tooltip><Tooltip text="Quick Add Customer"/></tooltip>
                    </Button>
                </HBox>

                <Label text="Phone:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="customerPhoneField" editable="false" promptText="Auto-filled" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-background-color: #f9f9f9;"/>

                <Label text="Order Date:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <DatePicker fx:id="orderDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="SO #:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="soNumberField" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1" style="-fx-background-color: #f9f9f9;"/>

                <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="statusCombo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <Separator/>

               <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Order Items" style="-fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↑" onAction="#handleMoveUp" styleClass="btn-secondary"/>
                <Button text="↓" onAction="#handleMoveDown" styleClass="btn-secondary"/>
                <Button text="+ Add Product" onAction="#handleAddLine" styleClass="btn-secondary"/>
                <Button text="+ Add Blank Item" onAction="#handleAddEmptyLine" styleClass="btn-secondary"/>
                <Button text="- Remove Item" onAction="#handleRemoveLine" styleClass="btn-danger"/>
            </HBox>

            <TableView fx:id="linesTable" VBox.vgrow="ALWAYS" editable="true">
                <columns>
                    <TableColumn fx:id="colProduct" text="Product / Description" prefWidth="220"/>
                    <TableColumn fx:id="colQty" text="Qty" prefWidth="70"/>
                    <TableColumn fx:id="colPrice" text="Unit Price" prefWidth="90"/>
                    <TableColumn fx:id="colSetPrice" text="Whole Set Price" prefWidth="110"/>
                    <TableColumn fx:id="colDiscountType" text="Disc Mode" prefWidth="85"/>
                    <TableColumn fx:id="colDiscount" text="Discount Value" prefWidth="95"/>
                    <TableColumn fx:id="colPackagePrice" text="Whole Set" prefWidth="75"/>
                    <TableColumn fx:id="colNotes" text="Notes" prefWidth="140"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="110"/>
                </columns>
            </TableView>

            <FlowPane hgap="8" vgap="6" alignment="CENTER_RIGHT">
                <Label text="Document discount:"/>
                <ComboBox fx:id="cmbDocumentDiscountType" prefWidth="135"/>
                <TextField fx:id="txtDocumentDiscountValue" promptText="0.00" prefWidth="90"/>
            </FlowPane>

            <FlowPane hgap="14" vgap="6" alignment="CENTER_RIGHT">
                <HBox spacing="5"><Label text="Subtotal:"/><Label fx:id="lblSubtotal" text="0.00"/></HBox>
                <HBox spacing="5"><Label text="Tax:"/><Label fx:id="lblTax" text="0.00"/></HBox>
                <HBox spacing="5"><Label text="Discount:"/><Label fx:id="lblDocumentDiscountAmount" text="0.00"/></HBox>
                <Label fx:id="totalLabel" text="" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            </FlowPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Edit" onAction="#handleEdit" styleClass="button-secondary"/>
                <Button text="Delete" onAction="#handleDelete" styleClass="button-danger"/>
                <Button text="Print Preview" onAction="#handlePrint" styleClass="button-secondary"/>
                <Button text="Save Order" onAction="#handleSave" styleClass="button-success"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>