<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.aceerp.controller.PurchaseOrderController" spacing="10" style="-fx-background-color: #f4f6f9;">
    <!-- LEFT SIDEBAR -->
    <VBox prefWidth="300" spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0;" HBox.hgrow="NEVER">
        <padding><Insets top="15" right="10" bottom="15" left="10"/></padding>
        <Label text="Purchase Orders" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="searchField" promptText="Search POs..." style="-fx-background-radius: 4; -fx-border-radius: 4;"/>
        <ListView fx:id="poListView" VBox.vgrow="ALWAYS" style="-fx-background-insets: 0; -fx-border-color: #e9ecef;"/>
        <HBox spacing="10">
            <Button text="+ New PO" onAction="#handleNewPO" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- RIGHT MAIN CONTENT -->
    <VBox fx:id="detailsPane" spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20;">
        <!-- HEADER GRID -->
        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="150" />
            </columnConstraints>
            
            <Label text="Supplier:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <HBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <TextField fx:id="supplierSearchField" promptText="Type to search..." HBox.hgrow="ALWAYS"/>
                <Button text="+" onAction="#handleQuickAddSupplier" style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
            </HBox>
            
            <Label text="PO Number:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="poNumberField" editable="false" style="-fx-background-color: #f8f9fa;" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Order Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <DatePicker fx:id="orderDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>
            
            <Label text="Expected Date:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <DatePicker fx:id="expectedDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="3" maxWidth="Infinity"/>

            <Label text="Status:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="statusCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>
        </GridPane>

        <Separator/>

        <!-- LINE ITEMS CONTROLS -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Order Items" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <CheckBox fx:id="globalTaxCheck" text="Apply Tax to All Items" onAction="#handleGlobalTaxToggle" selected="true" style="-fx-text-fill: #007bff; -fx-padding: 0 0 0 20;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Add Product" onAction="#handleAddLine" style="-fx-background-color: #f8f9fa; -fx-border-color: #ced4da;"/>
            <Button text="+ Add Blank Item" onAction="#handleAddEmptyLine" style="-fx-background-color: #f8f9fa; -fx-border-color: #ced4da;"/>
            <Button text="- Remove Item" onAction="#handleRemoveLine" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
        
        <TableView fx:id="linesTable" VBox.vgrow="ALWAYS" editable="true">
            <columns>
                <TableColumn fx:id="colProduct" text="Product / Description" prefWidth="250"/>
                <TableColumn fx:id="colQty" text="Qty" prefWidth="70"/>
                <TableColumn fx:id="colPrice" text="Unit Price" prefWidth="90"/>
                <TableColumn fx:id="colTaxable" text="Has VAT?" prefWidth="70"/>
                <TableColumn fx:id="colTaxRate" text="Tax %" prefWidth="70"/>
                <TableColumn fx:id="colTaxAmt" text="Tax Amount" prefWidth="90" editable="false"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="120" editable="false"/>
            </columns>
        </TableView>

        <!-- TOTALS & ACTION BUTTONS -->
        <HBox alignment="CENTER_RIGHT" spacing="20">
            <VBox alignment="CENTER_RIGHT" spacing="5">
                <Label fx:id="subtotalLabel" text="Subtotal: 0.00" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;"/>
                <Label fx:id="taxLabel" text="Tax: 0.00" style="-fx-font-size: 14px; -fx-text-fill: #6c757d;"/>
                <Label fx:id="totalLabel" text="Grand Total: 0.00" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Edit" onAction="#handleEdit" style="-fx-background-color: #ffc107;"/>
            <Button text="Delete" onAction="#handleDelete" style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
            <Button text="Print Preview" onAction="#handlePrint" style="-fx-background-color: #e2e6ea;"/>
            <Button text="Save Purchase Order" onAction="#handleSave" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</HBox>