<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aceerp.controller.InventoryController"
      styleClass="content-pane">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Navigation Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Inventory, Stock &amp; Assembly Build Management"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Stock In" onAction="#handleStockIn"
                style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
        <Button text="- Stock Out" onAction="#handleStockOut"
                style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
        <Button text="Adjust" onAction="#handleAdjust"
                style="-fx-background-color: #ffc107; -fx-text-fill: black;"/>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- Tab 1: Stock Movements & Low Stock Alerts -->
        <Tab text="Stock Movements &amp; Alerts">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Search movements..." prefWidth="250"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="btnAll" text="All" selected="true"/>
                    <ToggleButton fx:id="btnIn" text="In"/>
                    <ToggleButton fx:id="btnOut" text="Out"/>
                    <ToggleButton fx:id="btnAdjust" text="Adjust"/>
                </HBox>

                <TableView fx:id="movementsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="140"/>
                        <TableColumn fx:id="colProduct" text="Product" prefWidth="180"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                        <TableColumn fx:id="colQty" text="Qty" prefWidth="70"/>
                        <TableColumn fx:id="colBefore" text="Before" prefWidth="65"/>
                        <TableColumn fx:id="colAfter" text="After" prefWidth="65"/>
                        <TableColumn fx:id="colRef" text="Reference" prefWidth="120"/>
                        <TableColumn fx:id="colUser" text="User" prefWidth="90"/>
                        <TableColumn fx:id="colNotes" text="Notes" prefWidth="150"/>
                    </columns>
                </TableView>

                <VBox spacing="5" style="-fx-background-color: #fff3cd; -fx-padding: 10; -fx-border-color: #ffc107; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <Label text="Low Stock Alerts" style="-fx-font-weight: bold; -fx-text-fill: #856404;"/>
                    <Label fx:id="lowStockLabel" text="Loading..." wrapText="true" style="-fx-text-fill: #856404;"/>
                </VBox>
            </VBox>
        </Tab>

        <!-- Tab 2: Bill of Materials (BOM Recipes) -->
        <Tab text="Bill of Materials (BOM Recipes)">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Assembly Recipes (Finished Items &amp; Formulas)" style="-fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="＋ Create BOM Recipe" onAction="#handleCreateBom" styleClass="btn-primary"/>
                </HBox>

                <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
                    <VBox spacing="6">
                        <Label text="Bill of Materials Master" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TableView fx:id="tblBoms" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBomCode" text="BOM #" prefWidth="100"/>
                                <TableColumn fx:id="colBomAssyCode" text="Assy Code" prefWidth="110"/>
                                <TableColumn fx:id="colBomAssyName" text="Assembly Product" prefWidth="180"/>
                                <TableColumn fx:id="colBomDesc" text="Description" prefWidth="160"/>
                                <TableColumn fx:id="colBomCost" text="Unit Cost" prefWidth="110"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Recipe Raw Material Components" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TableView fx:id="tblBomComps" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCompCode" text="Code" prefWidth="90"/>
                                <TableColumn fx:id="colCompName" text="Component Name" prefWidth="200"/>
                                <TableColumn fx:id="colCompQty" text="Qty Req." prefWidth="90"/>
                                <TableColumn fx:id="colCompUnitCost" text="Unit Cost" prefWidth="100"/>
                                <TableColumn fx:id="colCompTotalCost" text="Total Cost" prefWidth="110"/>
                            </columns>
                        </TableView>
                    </VBox>
                </SplitPane>
            </VBox>
        </Tab>

        <!-- Tab 3: Build Assembly Executions -->
        <Tab text="Build Assemblies">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Assembly Work Orders &amp; Production History" style="-fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="⚡ Build Assembly Item" onAction="#handleBuildAssembly" styleClass="btn-success"/>
                </HBox>

                <TableView fx:id="tblBuilds" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colBuildNumber" text="Build #" prefWidth="110"/>
                        <TableColumn fx:id="colBuildBomCode" text="BOM #" prefWidth="110"/>
                        <TableColumn fx:id="colBuildAssyName" text="Assembly Built" prefWidth="220"/>
                        <TableColumn fx:id="colBuildQty" text="Qty Built" prefWidth="90"/>
                        <TableColumn fx:id="colBuildCost" text="Total Build Cost" prefWidth="130"/>
                        <TableColumn fx:id="colBuildDate" text="Date" prefWidth="110"/>
                        <TableColumn fx:id="colBuildNotes" text="Batch Memo" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>