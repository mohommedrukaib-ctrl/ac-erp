<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aceerp.controller.QuotationController"
            stylesheets="@../css/style.css">

    <!-- TOP: Title + Search + Actions -->
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="page-header">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label text="Quotations" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search quotations..." prefWidth="260"/>
            <Button text="+ New Quotation" onAction="#handleNewQuotation" styleClass="btn-primary"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary"/>
        </HBox>
    </top>

    <!-- CENTER: List (left) + Form (right) -->
    <center>
        <SplitPane dividerPositions="0.32" BorderPane.alignment="CENTER">
            <items>

                <!-- LEFT: Quotation list -->
                <VBox spacing="0" styleClass="list-panel">
                    <ListView fx:id="quotationListView" VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- RIGHT: Details form -->
                <VBox fx:id="detailsPane" spacing="12" styleClass="form-panel">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <!-- Action buttons -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="Edit" onAction="#handleEdit" styleClass="btn-secondary"/>
                        <Button text="Save" onAction="#handleSave" styleClass="btn-primary"/>
                        <Button text="Delete" onAction="#handleDelete" styleClass="btn-danger"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Convert to SO" onAction="#handleConvertToSO" styleClass="btn-secondary"/>
                        <Button text="Convert to Invoice" onAction="#handleConvertToInvoice" />
                        <Button text="Print" onAction="#handlePrint" styleClass="btn-secondary"/>
                    </HBox>

                    <!-- Header fields -->
                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                        </columnConstraints>

                        <Label text="Quote #:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="quoteNumberField" editable="false"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <DatePicker fx:id="quoteDatePicker"
                                    GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label text="Customer:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <TextField fx:id="customerSearchField" promptText="Search or type customer name..."
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="+" onAction="#handleQuickAddCustomer"
                                    styleClass="btn-secondary">
                                <tooltip>
                                    <Tooltip text="Quick Add Customer"/>
                                </tooltip>
                            </Button>
                        </HBox>

                        <Label text="Phone:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="customerPhoneField" editable="false"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="statusCombo" prefWidth="200"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <CheckBox fx:id="globalTaxCheck" text="Apply Tax to All"
                                  onAction="#handleGlobalTaxToggle"
                                  GridPane.columnIndex="2" GridPane.rowIndex="2"
                                  GridPane.columnSpan="2"/>
                    </GridPane>

                    <Separator/>

                    <!-- Line items toolbar -->
                    <FlowPane hgap="8" vgap="6" alignment="CENTER_LEFT">
                        <Label text="Line Items" styleClass="section-title"/>
                        <Button text="↑" onAction="#handleMoveUp" styleClass="btn-secondary">
                            <tooltip><Tooltip text="Move line up"/></tooltip>
                        </Button>
                        <Button text="↓" onAction="#handleMoveDown" styleClass="btn-secondary">
                            <tooltip><Tooltip text="Move line down"/></tooltip>
                        </Button>
                        <Button text="+ Add Product" onAction="#handleAddLine" styleClass="btn-secondary"/>
                        <Button text="+ Empty Line" onAction="#handleAddEmptyLine" styleClass="btn-secondary"/>
                        <Button text="Remove Line" onAction="#handleRemoveLine" styleClass="btn-danger"/>
                    </FlowPane>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Document discount:"/>
                        <ComboBox fx:id="cmbDocumentDiscountType" prefWidth="135"/>
                        <TextField fx:id="txtDocumentDiscountValue" promptText="0.00" prefWidth="90"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="chkDocumentPackagePrice" text="Pkg Price"/>
                        <Label text="Rs."/>
                        <TextField fx:id="txtDocumentPackagePrice" text="0" prefWidth="90"/>
                    </HBox>

                    <!-- Lines table -->
                    <TableView fx:id="linesTable" VBox.vgrow="ALWAYS" prefHeight="280">
                        <columns>
                            <TableColumn fx:id="colProduct" text="Product / Description" prefWidth="200"/>
                            <TableColumn fx:id="colQty" text="Qty" prefWidth="70"/>
                            <TableColumn fx:id="colPrice" text="Unit / Pkg Price" prefWidth="105"/>
                            <TableColumn fx:id="colDiscountType" text="Disc Mode" prefWidth="85"/>
                            <TableColumn fx:id="colDiscount" text="Discount Value" prefWidth="95"/>
                            <TableColumn fx:id="colTaxable" text="Tax" prefWidth="50"/>
                            <TableColumn fx:id="colNotes" text="Notes" prefWidth="130"/>
                            <TableColumn fx:id="colTotal" text="Line Total" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Totals -->
                    <FlowPane hgap="14" vgap="6" alignment="CENTER_RIGHT" styleClass="totals-bar">
                        <padding>
                            <Insets top="8" right="8" bottom="8" left="8"/>
                        </padding>
                        <HBox spacing="5"><Label text="Subtotal:"/><Label fx:id="lblSubtotal" text="0.00" styleClass="total-value"/></HBox>
                        <HBox spacing="5"><Label fx:id="lblTaxTitle" text="VAT:"/><Label fx:id="lblTax" text="0.00" styleClass="total-value"/></HBox>
                        <HBox spacing="5"><Label text="Discount:"/><Label fx:id="lblDocumentDiscountAmount" text="0.00" styleClass="total-value"/></HBox>
                        <Label fx:id="totalLabel" text="Total: 0.00" styleClass="grand-total"/>
                    </FlowPane>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>